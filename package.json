{
  "name": "shipsafe",
  "version": "1.0.0",
  "description": "Pre-Flight Blast Radius & Production Health Gatekeeper for Developers",
  "homepage": "https://stillzepta.github.io/shipsafe/",
  "main": "server.js",
  "type": "module",
  "bin": {
    "shipsafe": "./bin/shipsafe"
  },
  "scripts": {
    "start": "node server.js",
    "serve": "node bin/shipsafe serve",
    "scan": "node bin/shipsafe scan",
    "check": "node bin/shipsafe check",
    "check:all": "node bin/shipsafe check --all",
    "fix": "node bin/shipsafe fix",
    "commit": "node bin/shipsafe commit",
    "benchmark": "node benchmarks/suite.ts",
    "install-hooks": "node bin/shipsafe install-hooks",
    "test": "node --test tests/*.test.ts test/*.test.js"
  },
  "keywords": [
    "developer-productivity",
    "blast-radius",
    "git-hooks",
    "pre-commit",
    "pre-push",
    "code-health",
    "security-scanner",
    "developer-tooling",
    "quality-gate",
    "zero-downtime"
  ],
  "author": "ShipSafe Engineering",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
