#!/usr/bin/env node

/**
 * ShipSafe CLI
 * Local Pre-Flight Code Quality Gatekeeper
 */

import { runHealthCheck } from '../lib/engine.js';
import { loadConfig } from '../lib/config.js';
import { installGitHooks, uninstallGitHooks, getHookStatus, getCurrentBranch, getStagedFiles, getLatestCommit } from '../lib/git.js';
import { executeFix } from '../lib/fixers.js';
import { startServer } from '../server.js';
import { runCli } from '../src/cli/index.ts';
import { runBenchmark } from '../benchmarks/suite.ts';

const ARGS = process.argv.slice(2);
const COMMAND = ARGS[0] || 'check';

// Terminal Colors
const C = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  magenta: '\x1b[35m',
  cyan: '\x1b[36m',
  white: '\x1b[37m',
  bgRed: '\x1b[41m',
  bgGreen: '\x1b[42m',
  bgYellow: '\x1b[43m'
};

function banner() {
  console.log(`
${C.cyan}${C.bold}  ╔═══════════════════════════════════════════════════════════╗
  ║    🛡️   S H I P S A F E  —  Local Quality Gatekeeper      ║
  ║         Pre-flight health check before GitHub/Prod        ║
  ╚═══════════════════════════════════════════════════════════╝${C.reset}
`);
}

async function handleCheck() {
  banner();
  const cwd = process.cwd();
  const config = loadConfig(cwd);
  const checkAll = ARGS.includes('--all');
  const isHook = ARGS.find(a => a.startsWith('--hook='))?.split('=')[1];

  console.log(`${C.dim}Mode: ${checkAll ? 'Full Repository Audit' : 'Staged Changes Only'} ${isHook ? `[Hook: ${isHook}]` : ''}${C.reset}`);
  console.log(`${C.dim}Evaluating rules (Security, Hygiene, Git Guard, Syntax, Dependencies)...${C.reset}\n`);

  const result = await runHealthCheck(cwd, { config, all: checkAll });

  // Print Files Inspected
  console.log(`${C.bold}Inspected Files:${C.reset} ${result.filesChecked} file(s) on branch ${C.magenta}${result.branch}${C.reset}`);

  // Print Findings
  if (result.findings.length === 0) {
    console.log(`\n${C.green}✔ No issues detected! Code is clean and production-ready.${C.reset}`);
  } else {
    console.log(`\n${C.bold}Findings (${result.findings.length}):${C.reset}`);

    result.findings.forEach((f, idx) => {
      const badge = f.severity === 'ERROR' 
        ? `${C.bgRed}${C.white} ERROR ${C.reset}`
        : `${C.bgYellow}${C.white} WARN  ${C.reset}`;
      
      console.log(`\n  ${badge} ${C.bold}[${f.category}] ${f.title}${C.reset}`);
      console.log(`    ${C.dim}File:${C.reset} ${C.cyan}${f.filePath}${C.reset}:${C.yellow}${f.line}${C.reset}:${f.column}`);
      if (f.snippet) {
        console.log(`    ${C.dim}Snippet:${C.reset} ${f.snippet.length > 90 ? f.snippet.slice(0, 87) + '...' : f.snippet}`);
      }
      console.log(`    ${C.dim}Action:${C.reset}  ${C.white}${f.recommendation}${C.reset}`);
      if (f.autoFixable) {
        console.log(`    ${C.green}⚡ Auto-fixable via: npx shipsafe fix${C.reset}`);
      }
    });
  }

  // Score Bar
  console.log('\n' + '─'.repeat(60));
  const scoreColor = result.score >= 85 ? C.green : result.score >= 60 ? C.yellow : C.red;
  console.log(`${C.bold}Health Score:  ${scoreColor}${result.score} / 100${C.reset}  |  Duration: ${result.durationMs}ms`);

  const statusBadge = result.status === 'PASS'
    ? `${C.bgGreen}${C.white} PASS ${C.reset}`
    : result.status === 'WARN'
    ? `${C.bgYellow}${C.white} REVIEW ${C.reset}`
    : `${C.bgRed}${C.white} BLOCKED ${C.reset}`;

  console.log(`${C.bold}Gate Status:   ${statusBadge}  (${result.errorsCount} Errors, ${result.warningsCount} Warnings)`);
  console.log('─'.repeat(60) + '\n');

  if (result.status === 'BLOCKED') {
    console.log(`${C.red}${C.bold}❌ Quality gate failed! Fix the issues above before pushing.${C.reset}`);
    console.log(`${C.dim}Tip: Run 'npm run serve' to use the interactive browser dashboard.${C.reset}\n`);
    process.exit(1);
  } else {
    console.log(`${C.green}✨ Good to ship! Code passed pre-flight quality checks.${C.reset}\n`);
    process.exit(0);
  }
}

async function handleFix() {
  banner();
  const cwd = process.cwd();
  const config = loadConfig(cwd);
  const result = await runHealthCheck(cwd, { config, all: false, skipDb: true });

  const fixables = result.findings.filter(f => f.autoFixable && f.fixerType);
  if (fixables.length === 0) {
    console.log(`${C.yellow}No auto-fixable issues detected in staged files.${C.reset}`);
    return;
  }

  console.log(`${C.bold}Found ${fixables.length} auto-fixable issue(s). Applying repairs...${C.reset}\n`);

  for (const item of fixables) {
    const extra = Object.assign({ snippet: item.snippet, cleanCode: item.newCode || item.possibleSolution }, item.extraData || {});
    const res = executeFix(cwd, item.fixerType, item.filePath, extra);
    if (res.success) {
      console.log(`  ${C.green}✔ Fixed:${C.reset} ${item.title} -> ${item.filePath}`);
    } else {
      console.log(`  ${C.red}✖ Failed:${C.reset} ${item.filePath} (${res.message})`);
    }
  }

  console.log(`\n${C.green}✔ Auto-fix complete! Run 'shipsafe check' to re-verify.${C.reset}\n`);
}

function handleHooksInstall() {
  banner();
  const cwd = process.cwd();
  const res = installGitHooks(cwd);
  if (res.success) {
    console.log(`${C.green}✔ Git hooks installed successfully in .git/hooks/${C.reset}`);
    console.log(`  - ${C.bold}pre-commit${C.reset}: Prevents staging secrets, syntax errors, and debuggers.`);
    console.log(`  - ${C.bold}pre-push${C.reset}:   Prevents pushing broken builds or pushing to protected branches.`);
    console.log(`\n${C.dim}Every future 'git commit' and 'git push' will automatically run ShipSafe!${C.reset}\n`);
  }
}

function handleHooksUninstall() {
  banner();
  const cwd = process.cwd();
  uninstallGitHooks(cwd);
  console.log(`${C.yellow}Git hooks removed from .git/hooks/${C.reset}\n`);
}

function handleStatus() {
  banner();
  const cwd = process.cwd();
  const branch = getCurrentBranch(cwd);
  const commit = getLatestCommit(cwd);
  const staged = getStagedFiles(cwd);
  const hooks = getHookStatus(cwd);

  console.log(`${C.bold}Repository Health Status:${C.reset}`);
  console.log(`  Current Branch:  ${C.magenta}${branch}${C.reset}`);
  console.log(`  Latest Commit:   ${C.cyan}${commit.hash}${C.reset} - ${commit.message}`);
  console.log(`  Staged Files:    ${staged.length > 0 ? C.green + staged.length + ' file(s)' : C.dim + '0 files staged'}${C.reset}`);
  console.log(`  Git Hooks:       ${hooks.installed ? C.green + 'Active (pre-commit, pre-push)' : C.red + 'Not Installed (run: shipsafe install-hooks)'}${C.reset}`);
  console.log('');
}

function handleHelp() {
  banner();
  console.log(`${C.bold}Usage:${C.reset} shipsafe <command> [options]\n`);
  console.log(`${C.bold}Commands:${C.reset}`);
  console.log(`  ${C.cyan}check${C.reset}             Evaluate health checks on staged changes (default)`);
  console.log(`  ${C.cyan}scan${C.reset}              Run full pre-flight scan with blast radius analysis`);
  console.log(`  ${C.cyan}check --all${C.reset}       Evaluate health checks on all tracked files`);
  console.log(`  ${C.cyan}benchmark${C.reset}         Run empirical benchmark against 10 real-world outage traps`);
  console.log(`  ${C.cyan}commit [msg]${C.reset}      Atomic git commit with risk & blast radius tag`);
  console.log(`  ${C.cyan}serve${C.reset}             Launch the local interactive web dashboard & API`);
  console.log(`  ${C.cyan}fix${C.reset}               Auto-remediate fixable issues (unstage secrets, strip debuggers, sync .env)`);
  console.log(`  ${C.cyan}install-hooks${C.reset}     Install automated pre-commit and pre-push hooks`);
  console.log(`  ${C.cyan}uninstall-hooks${C.reset}   Remove git hooks`);
  console.log(`  ${C.cyan}status${C.reset}            Display current branch, staged files, and hook status`);
  console.log(`  ${C.cyan}help${C.reset}              Show this help message\n`);
}

// Router
switch (COMMAND) {
  case 'check':
    handleCheck();
    break;
  case 'scan':
    runCli(ARGS);
    break;
  case 'commit':
    runCli(ARGS);
    break;
  case 'benchmark':
    runBenchmark();
    break;
  case 'fix':
    handleFix();
    break;
  case 'serve':
  case 'server':
  case 'start': {
    const portArg = ARGS.find(a => a.startsWith('--port='));
    const port = portArg ? parseInt(portArg.split('=')[1], 10) : undefined;
    startServer({ port });
    break;
  }
  case 'install-hooks':
    handleHooksInstall();
    break;
  case 'uninstall-hooks':
    handleHooksUninstall();
    break;
  case 'status':
    handleStatus();
    break;
  case 'help':
  case '--help':
  case '-h':
    handleHelp();
    break;
  default:
    console.error(`Unknown command: ${COMMAND}`);
    handleHelp();
    process.exit(1);
}
